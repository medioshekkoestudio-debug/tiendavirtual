# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Solo servidor (NUNCA exponer en el cliente). Se usa en checkout, registro y seed.
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Dominio público (sin barra final). En local: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://linkiapp.com

# Avisos por WhatsApp al administrador (registros y pagos) con CallMeBot. Sin ellas no se envía nada.
# Atención al cliente (si se deja vacío usa 584225465427)
ADMIN_WHATSAPP_PHONE=584225465427
CALLMEBOT_APIKEY=

# Google Search Console: código de la etiqueta HTML de verificación (solo el valor de content)
GOOGLE_SITE_VERIFICATION=
