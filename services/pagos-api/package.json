{
  "name": "linki-pagos-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Validación automática de pagos de Linki App: OCR de comprobantes, movimientos del banco y conciliación",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "clave": "node -e \"console.log(require('crypto').randomBytes(32).toString('base64'))\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.134.0",
    "@hono/node-server": "2.1.4",
    "@supabase/supabase-js": "2.118.0",
    "hono": "4.13.13",
    "playwright": "1.64.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
