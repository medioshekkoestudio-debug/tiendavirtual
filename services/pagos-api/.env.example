# Copia a .env para correrlo en local (npm run dev). En Railway van en Variables.
SUPABASE_URL=https://pozexcjbxmoluftfxxus.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Token largo al azar; Linki App lo manda como Authorization: Bearer
API_TOKEN=
# Vacío = sin OCR (decidido el 29-10: no se paga OCR; se concilia con los 6 dígitos que escribe el usuario)
ANTHROPIC_API_KEY=
# Solo si algún día se enciende el OCR: claude-opus-5-5 (≈1–2 ¢/comprobante) o claude-haiku-5-5 (mucho más barato)
OCR_MODEL=claude-opus-5-5
# npm run clave
BANK_CREDENTIALS_KEY=
# false = modo sombra (anota lo que habría aprobado). Encender solo después de 1–2 semanas en sombra
AUTO_APPROVE=false
# off en local para no correr el reloj; las pasadas se piden con POST /conciliar
SCHEDULER=off
SCRAPE_EVERY_MIN=10
SCRAPE_COOLDOWN_MIN=3
OCR_MAX_PER_PASS=5
# BANCAMIGA_LOGIN_URL=
